{
  "compilerOptions": {
    // Keep automatic @types discovery for the existing browser and test globals.
    "types": null,
    // permit using ES6 imports for `*.ts` files via tsx/bun
    "allowImportingTsExtensions": true,
    "allowJs": true,
    // ensures single-file compilers, like babel, webpack+swc, etc work
    "isolatedModules": true,
    // makes typechecking faster (also see `tsBuildInfoFile` setting)
    "incremental": true,
    "jsx": "react",
    // This project includes browser code, tooling, and tests. Keep the browser
    // API baseline; Node-only build projects inherit the preset's libraries.
    "lib": ["DOM", "es2023"],
    // we only use tsc for type checking (yarn lint:tsc)
    "noEmit": true,
    // matches webpack's `symlinks: false`
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    // sets output file location for the `incremental` setting
    "tsBuildInfoFile": "node_modules/.cache/typescript/tsconfig.tsbuildinfo",
    "useUnknownInCatchVariables": true,
    // baseUrl is required for path mappings
    "baseUrl": ".",
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "app/vendor/",
    "development/.webpack/",
    "development/chromereload.js",
    "development/ts-migration-dashboard/build/",
    "test/e2e/send-eth-with-private-key-test/ethereumjs-tx.js",
    "test/e2e/send-eth-with-private-key-test/web3js.js",
    "test/test-results/",
    // don't typecheck stories, as they don't yet pass the type checker.
    "**/*.stories.tsx",
    "**/*.stories.ts"
  ],
  // Compiler baseline compatible with the supported Node.js runtimes.
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    // Must specify `/**/*` suffix for these so that tsc doesn't mistake the directory name as a file extension
    ".devcontainer/**/*",
    ".github/**/*",
    ".storybook/**/*",
    "app",
    "development",
    "shared",
    "test",
    "types",
    "ui",
    "*.mts",
    "*.ts"
  ]
}
