+++ b/dist/ses.cjs
@@ -4514,7 +4514,28 @@ const freezeTypedArray = array => {
           return;
         }
       }
-      error(`failed to delete ${subPath}`, reason);
+      if (
+      typeof obj === 'function' &&
+      (prop === 'caller' || prop === 'arguments') &&
+      hasOwn(obj, prop)
+    ) {
+      const desc = Object.getOwnPropertyDescriptor(obj, prop);
+      if (
+        desc &&
+        !desc.configurable &&
+        !desc.writable &&
+        !desc.get &&
+        !desc.set &&
+        desc.value === null
+      ) {
+        // Legacy "restricted properties" on older V8 (e.g. Chrome < 127) are
+        // undeletable own data properties whose value is null. They expose
+        // nothing, so tolerate them rather than failing lockdown outright.
+        warn(`Tolerating undeletable ${subPath} === null`);
+        return;
+      }
+    }
+    error(`failed to delete ${subPath}`, reason);
     } else {
       error(`deleting ${subPath} threw`, reason);
     }
