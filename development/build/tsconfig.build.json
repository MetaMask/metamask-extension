{
  "compilerOptions": {
    // Keep automatic @types discovery for the existing browser and test globals.
    "types": null,
    "esModuleInterop": true,
    "isolatedModules": true,
    "outDir": ".",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true,
    "noCheck": true
  },
  "exclude": ["*.test.ts", "transforms/**"],
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["constants.ts", "set-environment-variables.ts"]
}
