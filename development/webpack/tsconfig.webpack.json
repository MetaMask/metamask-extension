{
  "compilerOptions": {
    // Keep automatic @types discovery for the existing browser and test globals.
    "types": null,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "allowJs": true,
    "outDir": "../.webpack",
    "rootDir": "../..",
    "module": "commonjs",
    "moduleResolution": "node",
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noCheck": true
  },
  "exclude": ["test", "*.test.ts", "../build/**/*.ts", "../lib/**/*.ts"],
  // Compiler baseline compatible with the supported Node.js runtimes.
  "extends": "@tsconfig/node24/tsconfig.json"
}
