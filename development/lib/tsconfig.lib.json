{
  "compilerOptions": {
    // Keep automatic @types discovery for the existing browser and test globals.
    "types": null,
    "esModuleInterop": true,
    "isolatedModules": true,
    "outDir": "../..",
    "rootDir": "../..",
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true,
    "noCheck": true
  },
  "exclude": ["*.test.ts"],
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "build-type.ts",
    "get-manifest-flag.ts",
    "get-version.ts",
    "retry.ts",
    "variables.ts"
  ]
}
